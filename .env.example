# Все переменные необязательны: без .env прототип работает (LLM выключена, разбор по правилам).

# Порт внутри контейнера (в docker-compose проброшен 8080:8080)
PORT=8080

# LLM: none | openai (любой OpenAI-совместимый API) | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Для OpenAI-совместимых: https://openrouter.ai/api/v1 или http://host.docker.internal:11434/v1 (Ollama)
LLM_BASE_URL=

# Пути (по умолчанию так):
# ODIN_DB=/app/var/odin.sqlite
# ODIN_DATA=./data
# ODIN_REGION=./config/region.json
